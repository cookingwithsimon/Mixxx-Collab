+void ControllerScriptInterfaceLegacy::loadTrackFromLocation(
+        const QString& group, const QString& location, bool play) {
+    PlayerManager* pPlayerManager = PlayerManager::instance();
+    if (!pPlayerManager) {
+        qWarning() << "loadTrackFromLocation: no player manager";
+        return;
+    }
+    // Scripts run in the controller thread; the player manager lives in the
+    // main thread. Using it as the context object drops the call if it is
+    // destroyed before the call runs.
+    QMetaObject::invokeMethod(
+            pPlayerManager,
+            [pPlayerManager, location, group, play]() {
+                pPlayerManager->slotLoadLocationToPlayer(location, group, play);
+            },
+            Qt::QueuedConnection);
+}
+
+QString ControllerScriptInterfaceLegacy::getTrackLocation(const QString& group) {
+    TrackPointer pTrack = PlayerInfo::instance().getTrackInfo(group);
+    return pTrack ? pTrack->getLocation() : QString();
+}
